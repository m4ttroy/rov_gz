<launch>
  <arg name="world" default="ibvs_gz.world" description="World file name inside rov_gz/worlds"/>
  <arg name="world_name" default="ibvs_gz"/>
  <arg name="use_bridge" default="false" description="Start ros_gz_bridge"/>

  <let name="rov_gz_share" value="$(find-pkg-share rov_gz)"/>
  <let name="rov_gz_prefix" value="$(find-pkg-prefix rov_gz)"/>
  <let name="ardu_gazebo_dir" value="$(find-pkg-prefix ardupilot_gazebo)"/>

  <set_env name="GZ_SIM_RESOURCE_PATH" 
          value="$(var rov_gz_share)/models:$(var rov_gz_share)/worlds:$(env GZ_SIM_RESOURCE_PATH '')"/>
  <set_env name="GZ_SIM_SYSTEM_PLUGIN_PATH"
          value="$(var rov_gz_prefix)/lib:$(var ardu_gazebo_dir)/build:$(env GZ_SIM_SYSTEM_PLUGIN_PATH '')"/>

  <!-- Gazebo Simulation -->
  <executable cmd="gz sim -v4 -r $(var rov_gz_share)/worlds/$(var world)" output="screen"/>

  <!-- SUPRI + IBVS Bridge -->
  <group if="$(var use_bridge)">
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="camera_bridge" output="screen">
      <param name="config_file" value="$(var rov_gz_share)/config/camera_bridge.yaml"/>
    </node>
    <node pkg="topic_tools" exec="relay" name="left_ir_relay" output="screen"
          args="/camera/infra1/image_rect_raw /corrected/left/image_raw"/>
    <node pkg="topic_tools" exec="relay" name="right_ir_relay" output="screen"
          args="/camera/infra2/image_rect_raw /corrected/right/image_raw"/>
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="rov_bridge"  output="screen">
      <param name="config_file" value="$(var rov_gz_share)/config/supri_bridge.yaml"/>
    </node>
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="imu_bridge" 
          args="/world/$(var world_name)/model/supri_rov/link/base_link/sensor/imu_sensor/imu@sensor_msgs/msg/Imu[gz.msgs.IMU"
          output="screen">
      <remap from="/world/$(var world_name)/model/supri_rov/link/base_link/sensor/imu_sensor/imu" to="/model/supri_rov/imu"/>
    </node>
  </group>
</launch>
